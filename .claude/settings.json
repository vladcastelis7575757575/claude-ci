{
    "permissions": {
        "deny": [
            "Bash(git push --force *)",
            "Bash(git push --force)",
            "Bash(git push -f *)",
            "Bash(git push -f)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git commit *)",
                        "command": "python3",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit.py"
                        ],
                        "statusMessage": "Checking commit message",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "if": "Bash(git push *)",
                        "command": "python3",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit.py"
                        ],
                        "statusMessage": "Checking push safety",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": "npm run test"
                }
            ]
        }
    ]
}